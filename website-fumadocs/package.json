{
  "name": "ai-crash-courses-fumadocs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "postinstall": "fumadocs-mdx",
    "lint": "eslint .",
    "typecheck": "fumadocs-mdx && tsc --noEmit",
    "validate": "node scripts/validate.mjs",
    "validate:deployment": "SOURCE_VIDEO_POLICY=absent SKIP_ELEVENTY_OUTPUT=true node scripts/validate.mjs",
    "test": "npm run lint && npm run typecheck && npm run build && npm run validate",
    "migrate-content": "node scripts/migrate-content.mjs"
  },
  "dependencies": {
    "flexsearch": "0.8.212",
    "fumadocs-core": "16.16.2",
    "fumadocs-mdx": "15.4.6",
    "fumadocs-ui": "16.16.2",
    "lucide-react": "1.52.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/mdx": "2.0.14",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/turndown": "5.0.6",
    "cheerio": "1.1.2",
    "eslint": "10.12.0",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "4.3.3",
    "turndown": "7.2.4",
    "turndown-plugin-gfm": "1.0.2",
    "typescript": "6.0.3"
  }
}
